<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Maven Central namespace verified through the GitHub account (io.github.<user>). The Java
         packages stay dev.tenantguard: Central does not tie package names to the groupId. -->
    <groupId>io.github.yavuzhankursun</groupId>
    <artifactId>tenant-guard</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <name>tenant-guard</name>
    <description>Detects cross-tenant data leaks in Spring/JDBC tests from inside PostgreSQL via an RLS observer policy.</description>
    <url>https://github.com/yavuzhankursun/tenant-guard</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>yavuzhankursun</id>
            <name>Yavuzhan Kurşun</name>
            <url>https://github.com/yavuzhankursun</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/yavuzhankursun/tenant-guard</url>
        <connection>scm:git:https://github.com/yavuzhankursun/tenant-guard.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yavuzhankursun/tenant-guard.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/yavuzhankursun/tenant-guard/issues</url>
    </issueManagement>

    <!-- No spring-boot-starter-parent: a parent's version cannot be a property, and this library must
         be testable against several Boot lines (mvn -Dboot.version=3.2.12 test). The Boot BOM is
         imported below; what the parent used to configure (release, -parameters, encoding, plugin
         versions) is spelled out in <build>. -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Spring Boot BOM the build and tests run against. Its managed versions (postgresql.version,
             hibernate.version, testcontainers.version, ...) can be overridden with -D as before. -->
        <boot.version>3.5.11</boot.version>
        <!-- Documentation only: the oldest Boot line the CI matrix runs the full suite on. 3.0.13 and
             3.1.12 also pass (with -Pflyway10-fixture) but are out of OSS support and not in CI. -->
        <boot.min.version>3.2</boot.min.version>
        <!-- Test harness, pinned across Boot lines (the library does not depend on it). Boot 3.2/3.3
             manage 1.19.8, whose docker-java API version Docker Engine 29 rejects (HTTP 400). -->
        <testcontainers.version>1.21.4</testcontainers.version>

        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <!-- release profile -->
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Before the Boot BOM: for an artifact managed by both imports, the first one wins. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Library: the JDBC core needs only java.sql. Spring MVC, MockMvc, JUnit and Jackson are
             optional and only used by the endpoint scanner and the JUnit extension. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Sample app and scenario tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pool matrix (PoolMatrixTest, -Dtenantguard.pool=...): every pool wraps JDBC objects differently.
             Boot's BOM manages tomcat-jdbc, dbcp2 and caffeine; c3p0 and vibur are pinned. -->
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>tomcat-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-dbcp2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mchange</groupId>
            <artifactId>c3p0</artifactId>
            <version>0.14.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.vibur</groupId>
            <artifactId>vibur-dbcp</artifactId>
            <version>26.0</version>
            <scope>test</scope>
        </dependency>
        <!-- vibur's statement cache needs Caffeine (an optional dependency of vibur-dbcp). -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Wiring tests: Liquibase instead of Flyway (disabled everywhere else via config/application.properties),
             and the JUnit testkit to run fixtures whose setup must fail and assert the failure. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- As the Boot parent did: Spring resolves @PathVariable/@RequestParam names and
                         ParameterResolutionDelegate parameters from the -parameters metadata. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <!-- Matrix knobs reach the forked test JVM without per-key config: surefire copies every
                     Maven user property (-Dtenantguard.pg.image=..., -Dtenantguard.pool=...,
                     -Dpostgresql.version=...) into its system properties, and the fork inherits the
                     environment (TENANTGUARD_PG_IMAGE). Listing them as systemPropertyVariables would
                     instead pass a literal "${...}" when a knob is not set. -->
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- -Dpostgresql.version=42.6.2 swaps the JDBC driver. A property of an imported BOM cannot be
             overridden from the command line (only a parent's could), so the override is an explicit
             managed version, which wins over the import. Without the property Boot's version applies. -->
        <profile>
            <id>pgjdbc-version</id>
            <activation>
                <property>
                    <name>postgresql.version</name>
                </property>
            </activation>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>

        <!-- Boot 3.0-3.2 manage Flyway 9, which has no flyway-database-postgresql module (the test
             fixture's migrations need it from Flyway 10 on). The library itself does not use Flyway;
             on those lines the fixture runs Flyway 10.10.0, the version Boot 3.3.0 moved to.
             Activates on -Dboot.version=3.2.12 (the CI matrix); for any other pre-3.3 Boot add
             -Pflyway10-fixture. -->
        <profile>
            <id>flyway10-fixture</id>
            <activation>
                <property>
                    <name>boot.version</name>
                    <value>3.2.12</value>
                </property>
            </activation>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-core</artifactId>
                        <version>10.10.0</version>
                    </dependency>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>10.10.0</version>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>

        <!-- Maven Central release: sources + javadoc jars, GPG signatures, upload to the Central Portal.
             Local dry run (no key needed): mvn -Prelease -Dgpg.skip -DskipTests package
             CI (.github/workflows/release.yml): mvn -Prelease -DskipTests deploy, with the key imported
             into gpg, MAVEN_GPG_PASSPHRASE set and server "central" in settings.xml. autoPublish is
             off: the deployment waits in https://central.sonatype.com/publishing/deployments until it
             is published (or dropped) by hand. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <!-- Every doclint group except "missing" (undocumented parameters, returns
                                 and record components: ~100 today), and any warning fails the release,
                                 so broken HTML, dangling {@link}s and bad syntax never reach Central. -->
                            <doclint>all,-missing</doclint>
                            <failOnWarnings>true</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <!-- Default signer "gpg": signs with the default (or -Dgpg.keyname) key of
                                 the imported keyring. The passphrase comes from the MAVEN_GPG_PASSPHRASE
                                 environment variable; loopback lets gpg take it without a TTY. -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <!-- Fail the build if Central rejects the bundle (missing signature,
                                 javadoc, POM metadata), instead of only uploading it. -->
                            <waitUntil>validated</waitUntil>
                            <deploymentName>${project.artifactId} ${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mutation testing of the JDBC core: mvn -B -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
             The default build is untouched. Reports land in target/pit-reports (index.html, mutations.xml). -->
        <profile>
            <id>mutation</id>
            <dependencies>
                <!-- pitest-junit5-plugin 1.2+ uses the launcher on the test classpath instead of bundling one. -->
                <dependency>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-launcher</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>dev.tenantguard.*</param>
                            </targetClasses>
                            <excludedClasses>
                                <param>dev.tenantguard.scan.*</param>
                                <param>dev.tenantguard.junit.*</param>
                                <param>dev.tenantguard.spring.*</param>
                            </excludedClasses>
                            <targetTests>
                                <param>dev.tenantguard.*Test</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>dev.tenantguard.scan.*</param>
                            </excludedTestClasses>
                            <mutators>
                                <mutator>STRONGER</mutator>
                            </mutators>
                            <!-- Each minion JVM starts its own Postgres container (GuardedTestBase's static
                                 block) and Spring context; more threads mean more containers at once. -->
                            <threads>2</threads>
                            <!-- The first test in a minion pays container + Spring start-up (10-20 s). A short
                                 timeout would count that as TIMED_OUT, i.e. a falsely "killed" mutant. -->
                            <timeoutConstant>180000</timeoutConstant>
                            <timeoutFactor>3</timeoutFactor>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
